# examples -- every check in the repo, from the root.
#
#   make lint      every gate CI runs: the shell scripts (shellcheck,
#                  shfmt), the script hash table, and c-by-example's
#                  formatting (mdformat, clang-format)
#   make test      build and check every c-by-example lesson
#   make format    the fixers the lint gates call
#
# CI runs `make lint` (.github/workflows/lint.yml) and `make test`
# (c-by-example.yml).
#
# python-c-extension/ is generated by just-makeit and has its own
# Makefile; run it there (see README.md).

.PHONY: lint lint-shellcheck lint-shfmt lint-hashes lint-c-by-example \
        test format help

# Every shell script in the repo, tracked or new. shellcheck and shfmt are
# pinned in pyproject.toml (uv.lock), at the versions just-bashit uses.
SH_FILES := $(shell git ls-files -co --exclude-standard '*.sh')
UV_LINT  := uv run --frozen --only-group lint
# -s simplifies where it can, as just-bashit's pre-commit hook does.
SHFMT_FLAGS := -s

lint: lint-shellcheck lint-shfmt lint-hashes lint-c-by-example ## Every gate CI runs

lint-shellcheck: ## Every shell script passes shellcheck
	@$(UV_LINT) shellcheck $(SH_FILES)

lint-shfmt: ## Every shell script is as shfmt writes it
	@$(UV_LINT) shfmt $(SHFMT_FLAGS) -d $(SH_FILES)

lint-hashes: ## scripts/README.md's sha256 table matches the scripts
	@.github/scripts/check-hashes.sh

lint-c-by-example: ## Every lesson README and C file is formatted
	@$(MAKE) --no-print-directory -C c-by-example lint

test: ## Build, run and check every c-by-example lesson
	@$(MAKE) --no-print-directory -C c-by-example test

format: ## Format the shell scripts, and c-by-example's READMEs and C
	@$(UV_LINT) shfmt $(SHFMT_FLAGS) -w $(SH_FILES)
	@$(MAKE) --no-print-directory -C c-by-example format

help: ## Show this message
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | \
	  sed 's/:.*## /\t/' | expand -t 20
