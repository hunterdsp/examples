# examples -- every check in the repo, from the root.
#
#   make lint      every gate CI runs: the shell scripts (shellcheck,
#                  shfmt), American spelling (codespell), the script
#                  hash table, and c-by-example's formatting (mdformat,
#                  clang-format), library function links, and back/next
#                  links
#   make test      build and check every c-by-example lesson
#   make docs      build c-by-example's website (CI publishes it from main)
#   make format    the fixers the lint gates call
#   make hooks     install the pre-commit hooks, once per clone: every
#                  commit then runs the lint gates for the files it touches
#
# CI runs `make lint` (.github/workflows/lint.yml), `make test`
# (c-by-example.yml) and `make docs` (site.yml).
#
# python-c-extension/ is generated by just-makeit and has its own
# Makefile; run it there (see README.md).

.PHONY: lint lint-shellcheck lint-shfmt lint-spelling lint-hashes \
        lint-mdformat lint-clang-format lint-libfuncs lint-nav test docs \
        format hooks help

# Every shell script in the repo, tracked or new. shellcheck and shfmt are
# pinned in pyproject.toml (uv.lock), at the versions just-bashit uses.
SH_FILES := $(shell git ls-files -co --exclude-standard '*.sh')
UV_LINT  := uv run --frozen --only-group lint
# -s simplifies where it can, as just-bashit's pre-commit hook does.
SHFMT_FLAGS := -s

# American spelling, everywhere: prose, code, output and file names.
# codespell's GB-to-US dictionary (-D -) plus .codespell-us.txt, the words
# it does not list. python-c-extension/ is generated by just-makeit, so a
# spelling there is fixed upstream, not here.
SPELL_FILES := $(shell git ls-files -co --exclude-standard | \
                 grep -vE '^python-c-extension/|\.lock$$')
CODESPELL   := $(UV_LINT) codespell --builtin en-GB_to_en-US \
                 -D - -D .codespell-us.txt --check-hidden --check-filenames

GATES := lint-shellcheck lint-shfmt lint-spelling lint-hashes lint-mdformat \
         lint-clang-format lint-libfuncs lint-nav

lint: $(GATES) ## Every gate CI runs

lint-shellcheck: ## Every shell script passes shellcheck
	@$(UV_LINT) shellcheck $(SH_FILES)

lint-shfmt: ## Every shell script is as shfmt writes it
	@$(UV_LINT) shfmt $(SHFMT_FLAGS) -d $(SH_FILES)

lint-spelling: ## American spelling, in every file and file name
	@$(CODESPELL) $(SPELL_FILES)

lint-hashes: ## scripts/README.md's sha256 table matches the scripts
	@.github/scripts/check-hashes.sh

lint-mdformat: ## Every c-by-example README is as mdformat writes it
	@$(MAKE) --no-print-directory -C c-by-example lint-mdformat

lint-clang-format: ## Every c-by-example C file is as clang-format writes it
	@$(MAKE) --no-print-directory -C c-by-example lint-clang-format

lint-libfuncs: ## Every lesson's README links the library functions it calls
	@$(MAKE) --no-print-directory -C c-by-example lint-libfuncs

lint-nav: ## Every lesson links back, to the contents, and on
	@$(MAKE) --no-print-directory -C c-by-example lint-nav

test: ## Build, run and check every c-by-example lesson
	@$(MAKE) --no-print-directory -C c-by-example test

docs: ## Build c-by-example's website into c-by-example/build/site/html
	@$(MAKE) --no-print-directory -C c-by-example docs

format: ## American spelling; format the shell scripts, READMEs and C
	@$(CODESPELL) -w $(SPELL_FILES)
	@$(UV_LINT) shfmt $(SHFMT_FLAGS) -w $(SH_FILES)
	@$(MAKE) --no-print-directory -C c-by-example format

hooks: ## Install the pre-commit hooks (once per clone)
	@$(UV_LINT) pre-commit install

help: ## Show this message
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | \
	  sed 's/:.*## /\t/' | expand -t 20
