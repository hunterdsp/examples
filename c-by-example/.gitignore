# What following a lesson leaves behind: the programs it builds (named
# after their .c, so no extension), at any depth, and the -E / -S / -c
# intermediates. Directories, files with an extension and Makefiles stay.
[0-9][0-9]-*/**
![0-9][0-9]-*/**/
![0-9][0-9]-*/**/*.*
![0-9][0-9]-*/**/Makefile
*.o
*.s
*.i
# What building a library leaves: archives, shared libraries, and the
# directories a build or an install writes.
*.a
*.so
*.so.*
*.dylib
[0-9][0-9]-*/**/build/
[0-9][0-9]-*/**/staging/
